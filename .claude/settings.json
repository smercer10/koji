{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(zig build:*)",
      "Bash(zig fmt:*)",
      "Bash(zig env)",
      "Bash(zig version)",
      "Bash(zig test:*)",
      "Bash(make:*)",
      "Bash(./zig-out/bin/koji:*)",
      "Bash(fastchess:*)",
      "Bash(./tools/fastchess/fastchess:*)",
      "Bash(perf stat:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "WebFetch(domain:chessprogramming.org)",
      "WebFetch(domain:www.chessprogramming.org)",
      "WebFetch(domain:ziglang.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],

    "deny": [
      "Bash(gh issue comment:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh api --method POST:*)",
      "Bash(gh api -X POST:*)",
      "Bash(gh api --method PATCH:*)",
      "Bash(gh api -X PATCH:*)",
      "Bash(gh issue create --repo:*)",
      "Bash(gh issue create -R:*)",
      "Bash(gh pr create --repo:*)",
      "Bash(gh pr create -R:*)",
      "Bash(gh issue:* --repo:*)",
      "Bash(gh issue:* -R:*)",
      "Bash(gh pr:* --repo:*)",
      "Bash(gh pr:* -R:*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/fmt.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate.sh"
          }
        ]
      }
    ]
  }
}
