.{
    .name = .koji,
    .version = "0.0.0",

    // Generated by the toolchain and then never changed. Changing it has security
    // and trust implications: it is half of this package's globally unique
    // identity, and rewriting it claims to *be* another package.
    .fingerprint = 0x259479d28a6be42d, // Changing this has security and trust implications.

    // build.zig additionally pins 0.16.0 exactly, at comptime.
    .minimum_zig_version = "0.16.0",

    // Intentionally empty, and expected to stay that way. A new dependency needs
    // a written justification first — see the ethos block in CLAUDE.md.
    .dependencies = .{},

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
